# Copy this file to `.env` and adjust for your environment.

# Where the app sends API requests.
#   Development:  keep "/api" — the dev server (vite.config.ts) forwards it
#                 to the real backend for you.
#   Production:   set the full backend URL, e.g.
#                 VITE_API_BASE_URL=https://api.yourdomain.com
#                 (the backend must allow CORS from your site's domain)
VITE_API_BASE_URL=/api
